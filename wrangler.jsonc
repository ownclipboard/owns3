/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "owns3",
	"main": "./.output/server/index.mjs",
	"compatibility_date": "2026-09-11",
	"assets": {
		"binding": "ASSETS",
		"directory": "./.output/public/"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	/**
	 * D1 database. Create one with `wrangler d1 create owns3` and paste the returned id below.
	 * Migrations live in server/database/migrations and are applied with `npm run db:migrate`.
	 */
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "owns3",
			"database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
			"migrations_dir": "server/database/migrations"
		}
	]
	/**
	 * Secrets (never put these in "vars"):
	 *   SECRET_KEY - encrypts stored S3 secret keys and signs the admin session cookie.
	 *   Set it with `wrangler secret put SECRET_KEY`. Locally, put it in `.dev.vars` (see .dev.vars.example).
	 */
}
